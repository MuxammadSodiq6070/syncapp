# Copy to .env and fill in. .env is ignored by version control; never put these in the app.

# Supabase: Project Settings > Database > Connection string. Use the direct connection,
# or the session pooler if your host has no IPv6. Keep ?sslmode=require.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require

# Supabase: Project Settings > API. The service role key bypasses all access rules, so it
# belongs on the gateway only. Leave both empty to keep media on local disk.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Without a key the AI screens say AI isn't set up.
ANTHROPIC_API_KEY=
# SYNC_AI_MODEL=claude-opus-5-5
# SYNC_AI_MAX_PER_MINUTE=60
# SYNC_AI_MAX_PER_DAY=2000

# Sign-up verification. One phone number can open one account, whichever path is used.
# At least 32 characters. The gateway stores only a keyed hash of each number, and
# NEVER change this afterwards: every existing number would stop matching, so anyone
# could register again with a number that already has an account.
SYNC_PHONE_HASH_KEY=

# Four ways of proving a number are written and tested; docs/VERIFICATION.md explains
# each one and how to switch. Setting one of these takes precedence over the ones
# below it, and the gateway logs which is in force on every start.

# Path A, in use: a Telegram bot. Free forever, because Telegram does the verifying
# when the person taps the share-number button. Make the bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Required for the bot: the gateway registers its webhook at <this>/bot/update.
SYNC_PUBLIC_URL=

# Path B, written: Telegram's paid verification platform. No bot and no action from
# the person; the code lands in Telegram's own "Verification Codes" chat. $0.01 each,
# funded in TON through Fragment. Get the token at gateway.telegram.org.
TELEGRAM_GATEWAY_TOKEN=

# Path C, written: SMS through Eskiz.uz, for when there is a company to sign their
# contract. Needs an INN, so a private person cannot use it.
# ESKIZ_EMAIL is the account's login email, ESKIZ_PASSWORD its secret key.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Sender name. Empty uses Eskiz's shared 4546. A name of your own needs its own approval.
ESKIZ_FROM=
# The message, with %s where the code goes. Eskiz delivers nothing that does not match
# a template its moderators have approved, so this text and the approved one must be
# identical, character for character. Empty uses:
#   Sync: tasdiqlash kodi %s. Hech kimga bermang.
SYNC_SMS_TEMPLATE=
# Codes a day across all numbers, so a bug cannot empty the provider balance.
# Applies to whichever provider is in use. Default 2000.
SYNC_SMS_MAX_PER_DAY=

# Path D, written: with a project id set and no provider above, a new account
# must present a Firebase ID token proving a phone number. Needs a Blaze plan and a
# card. Leave everything above empty to keep sign-up open (local development, tests).
FIREBASE_PROJECT_ID=
